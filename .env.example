# Copy to .env and fill in. .env is gitignored — never commit keys.
# `make run` sources .env automatically; one-off commands need it exported
# (e.g. `set -a; . ./.env; set +a`).

DB_PASSWORD=cortex_dev

# LLM_PROVIDER=gemini|openrouter (default: gemini)
LLM_PROVIDER=openrouter

# Only the active provider's key is required:
OPENROUTER_API_KEY=...
# GOOGLE_API_KEY=...
